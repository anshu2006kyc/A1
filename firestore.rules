rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Plans Catalog
    match /plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // User Investment Plans
    match /userPlans/{userPlanId} {
      allow read: if true;
      allow write: if true;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Settings
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
